#### lib_http <- prelude

:| prelude

;;; Bar helpers ;; TODO move these?

= (printNat n) | natBar | showNat n

;; Like barSubstringLines, but allows splitting on arbitrary characters.
> Bar > Bar > List Bar
= (barSubstringLinesList seek bar)
@ indices (barSubstringSearch seek bar)
@ seekLen (barLen seek)
@ wid (barLen bar)
| listFilter (compose not barIsEmpty)
^ _ 0 indices
? (go start idxList)
: idx rest < listCase idxList
           | listSing (barSlice start (sub wid start) bar)
| CONS (barSlice start (sub idx start) bar)
| go (add idx seekLen) rest

(barSubstringLines seek bar)=(listToRow | barSubstringLinesList seek bar)

=?= ~[x#de x#ad x#20be x#ef]
  | barSubstringLinesList x#0d x#{de0dad0d20be0def0d0d}

=?= [x#de x#ad x#20be x#ef]
  | barSubstringLines x#0d x#{de0dad0d20be0def0d0d}

=?= ~[x#de x#ad x#20be x#ee x#ef]
  | barSubstringLinesList x#0d x#{de0dad0d20be0dee0def}

=?= ~[x#de x#ad x#20be x#ef]
  | barSubstringLinesList x#0d x#{0d0dde0dad0d20be0def0d}

=?= ~[x#de x#ad x#200dbe x#ef]
  | barSubstringLinesList x#0d0a0d x#{de0d0a0dad0d0a0d200dbe0d0a0def0d0a0d}


> Bar > Bar > Maybe (Bar, Bar)
= (barSplitOnSubstring substr bar)
: idx _ < listCase | barSubstringSearch substr bar
        | NONE
| SOME (barTake idx bar, barDrop (add idx (barLen substr)) bar)


=?= SOME-[b#foo b#baz]   | barSplitOnSubstring b#bar b#foobarbaz
=?= SOME-[b#{} b#barbaz] | barSplitOnSubstring b#foo b#foobarbaz
=?= SOME-[b#foobar b#{}] | barSplitOnSubstring b#baz b#foobarbaz
=?= NONE                 | barSplitOnSubstring b#{ } b#foobarbaz


= CRLF        | x#0d0a
= DOUBLE_CRLF | x#0d0a0d0a


;;; HTTP types

# datatype Method
* GET=GET
* POST=POST


# record HTTPRequest
| HTTP_REQ
* reqMethod  : Method          ; HTTP method
* reqPath    : Bar             ; Request URI
* reqVersion : Bar             ; HTTP version
* reqHeaders : Tab Bar Bar     ; Request headers
* reqBody    : Pin Bar         ; Request body; may be empty


> HTTPRequest > Bar
= (httpReqToBar httpReq)
@ HTTP_REQ(..) | httpReq
@ headers | barIntercalateList CRLF
          | tabValsList
          | tabMapWithKey (k v & barCat [k b#{: } v]) reqHeaders
| barCat
++ natBar reqMethod
++ b#{ }
++ reqPath
++ b#{ }
++ reqVersion
++ CRLF
++ headers
++ DOUBLE_CRLF
++ pinItem reqBody


# record HTTPResponse
| HTTP_RES
* version      : Bar             ; HTTP version
* statusCode   : Nat             ; Numeric status code (for automata)
* reasonPhrase : Bar             ; e.g "OK", "Not Found" (for humans)
* resHeader    : Tab Bar Bar     ; Response headers
* resBody      : Bar             ; Response body ;; TODO pin this?


> HTTPResponse > Bar
= (httpResToBar httpRes)
@ v     | getVersion      httpRes
@ c     | getStatusCode   httpRes
@ s     | getReasonPhrase httpRes
@ h     | getResHeader    httpRes
@ b     | getResBody      httpRes
@ statusLine         | barCat [v x#20 (natBar | showNat c) x#20 s]
@ headersSeparated   | barIntercalateList CRLF h
@ printBodySeparator | if (barIsEmpty b) b#{} DOUBLE_CRLF
| barCat
++ statusLine
++ CRLF
++ headersSeparated
++ printBodySeparator
++ b


= (error400 msg)
@ headers | tabIns b#{Content-Length} 0
          | tabSing b#{Server} b#{Pallas/0.1}
@ headersList | tabValsList
              | tabMapWithKey (k v & (barCat [k b#{: } v]))
              | headers
| HTTP_RES
;; TODO: move these things to "constants"
* b#{HTTP/1.0}
* 400
* msg
* headersList
* NIL


= (error500 msg)
@ headers | tabIns b#{Content-Length} 0
          | tabSing b#{Server} b#{Pallas/0.1}
@ headersList | tabValsList
              | tabMapWithKey (k v & (barCat [k b#{: } v]))
              | headers
| HTTP_RES
;; TODO: move these things to "constants"
* b#{HTTP/1.0}
* 500
* msg
* headersList
* NIL


;;; Request parsing

# datatype ReqParserState
* AWAITING_REQ_LINE
* AWAITING_REQ_HEADERS      reqLine:(Method,Bar,Bar)
* AWAITING_REQ_BODY len:Nat reqLine:(Method,Bar,Bar) headers:(Tab Bar Bar)
* COMPLETE_REQ              reqLine:(Method,Bar,Bar) headers:(Tab Bar Bar) body:Bar
* PARSER_ERROR  err:Bar


# record ReqParser
| REQ_PARSER
* accumulated : Bar
* state       : ReqParserState


= newReqParser
| REQ_PARSER
* b#{}
* AWAITING_REQ_LINE


# datatype ResParserState
* AWAITING_RES_LINE
* AWAITING_RES_HEADERS      statusLine:(Bar,Nat,Bar)
* AWAITING_RES_BODY len:Nat statusLine:(Bar,Nat,Bar) headers:(Tab Bar Bar)
* COMPLETE_RES              statusLine:(Bar,Nat,Bar) headers:(Tab Bar Bar) body:Bar
* PARSER_ERROR err:Bar


# record ResParser
| RES_PARSER
* accumulated : Bar
* state       : ResParserState


= newResParser
| RES_PARSER
* b#{}
* AWAITING_RES_LINE


> ReqParserState > Maybe (Tab Bar Bar)
= (getReqHeaders p)
# datacase p
* (AWAITING_REQ_BODY _ _ headers) | SOME headers
* (COMPLETE_REQ _ headers _)      | SOME headers
* _                               | NONE


> Bar > Maybe (Method, Bar, Bar)
= (parseRequestLine line)
@ parts | listToRow | barSplit { } line
| maybeGuard (len-parts == 3)
@ [method path version] | parts
@ method | barNat method
| maybeGuard (any (eql method) [GET POST]) ;; TODO remove once we have types
; maybeGuard (version == b#{HTTP/1.0}) ;; TODO eeh?
| SOME (method, path, version)


> ReqParser > ((Method, Bar, Bar) > Bar > ReqParser) > ReqParser
= (processReqLine parser step)
# datacase | getState parser
* _ | parser
* AWAITING_REQ_LINE
: (line, rest) < maybeCase | barSplitOnSubstring CRLF | getAccumulated parser
               | parser
: reqLineParts < maybeCase | parseRequestLine line
               | setState (PARSER_ERROR b#{Invalid request line}) parser
| step reqLineParts rest


> Bar > Tab Bar Bar
= (parseHeaders bar)
^ listFoldl _ emptyTab | barSubstringLinesList CRLF bar
& (headers line)
@ (key,val) | barSplitOne {:} line
@ key | barMap toLower | barTrim key
@ val | barTrim val
| if barIsEmpty-key | headers
| tabIns key val headers


> ReqParser > (Tab Bar Bar > Bar > ReqParser) > ReqParser
= (processReqHeaders parser step)
@ REQ_PARSER(..) parser
# datacase state
* _ | parser
* AWAITING_REQ_HEADERS|_
: (headerBar, rest) < maybeCase | barSplitOnSubstring DOUBLE_CRLF accumulated
                    | parser
@ headers | parseHeaders headerBar
| step headers rest


= (processReqBody parser step)
@ REQ_PARSER(..) parser
# datacase state
* _ | parser
* (AWAITING_REQ_BODY sz _ _)
| if (gth sz | barLen accumulated) | parser
| uncurry step | barSplitAt sz accumulated


= (stepReqParser parser)
@ REQ_PARSER(..) parser
# datacase state
* (COMPLETE_REQ _ _ _)   | parser
* (PARSER_ERROR msg) | parser
* AWAITING_REQ_LINE
  : reqLine rest < processReqLine parser
  | stepReqParser
  | REQ_PARSER rest | AWAITING_REQ_HEADERS reqLine
* (AWAITING_REQ_HEADERS reqLine)
  : headers rest < processReqHeaders parser
  | fromSome
    | REQ_PARSER rest | COMPLETE_REQ reqLine headers b#{}
  : contentLength < bindMaybe | tabLookup b#{content-length} headers ;; TODO map keys to lowercase
  : sz            < bindMaybe | parseNat contentLength ;; TODO error instead
  | maybeGuardNot | eql sz 0
  ^ SOME | stepReqParser _
  | REQ_PARSER rest | AWAITING_REQ_BODY sz reqLine headers
* (AWAITING_REQ_BODY _ reqLine headers)
  : body rest < processReqBody parser
  | ifNot (barIsEmpty rest)
    | setState (PARSER_ERROR (b#{body too long}, [=body =rest])) parser
  | REQ_PARSER rest | COMPLETE_REQ reqLine headers body


> ReqParser > Bar > ReqParser
= (feedReqData parser newData)
@ cum | getAccumulated parser
| stepReqParser | setAccumulated (barWeld cum newData) parser


> ReqParser > Maybe (Either Bar HTTPRequest)
= (getRequest parser)
# datacase | getState parser
* _                | NONE
* PARSER_ERROR|msg | SOME LEFT-msg
* (COMPLETE_REQ (method,path,version) headers body)
^ SOME | RIGHT _
| HTTP_REQ
* method
* path 
* version
* headers
* PIN body


> Bar > Maybe (Bar, Nat, Bar)
= (parseStatusLine line)
@ [version rest]   | barSplitOne { } line
@ [codeBar reason] | barSplitOne { } rest
: code < bindMaybe | parseNat codeBar
| SOME (version, code, reason)


> ResParser > ((Bar, Nat, Bar) > Bar > ResParser) > ResParser
= (processStatusLine parser step)
# datacase | getState parser
* _ | parser
* AWAITING_RES_LINE
: (line, rest) < maybeCase | barSplitOnSubstring CRLF | getAccumulated parser
               | parser
: statusLineParts < maybeCase | parseStatusLine line
                  | setState (PARSER_ERROR b#{Invalid status line}) parser
| step statusLineParts rest


> ResParser > (Tab Bar Bar > Bar > ResParser) > ResParser
= (processResHeaders parser step)
@ RES_PARSER(..) parser
# datacase state
* _ | parser
* AWAITING_RES_HEADERS|_
: (headerBar, rest) < maybeCase | barSplitOnSubstring DOUBLE_CRLF accumulated
                    | parser
@ headers | parseHeaders headerBar
| step headers rest

= (processResBody parser step)
@ RES_PARSER(..) parser
# datacase state
* _ | parser
* (AWAITING_RES_BODY sz _ _)
| if (gth sz | barLen accumulated) | parser
| uncurry step | barSplitAt sz accumulated


= (stepResParser parser)
@ RES_PARSER(..) parser
# datacase state
* (COMPLETE_RES _ _ _)   | parser
* (PARSER_ERROR msg) | parser
* AWAITING_RES_LINE 
  : statusLine rest < processStatusLine parser
  | stepResParser
  | RES_PARSER rest | AWAITING_RES_HEADERS statusLine
* (AWAITING_RES_HEADERS statusLine)
  : headers rest < processResHeaders parser
  | fromSome | RES_PARSER rest | COMPLETE_RES statusLine headers b#{}
  : contentLength < bindMaybe | tabLookup b#{content-length} headers ;; TODO lowercase keys
  : sz            < bindMaybe | parseNat contentLength ;; TODO error instead
  | maybeGuardNot sz==0
  ^ SOME | stepResParser _
  | RES_PARSER rest | AWAITING_RES_BODY sz statusLine headers
* (AWAITING_RES_BODY _ statusLine headers)
  : body rest < processResBody parser
  | ifNot (barIsEmpty rest)
    | setState (PARSER_ERROR (b#{body too long}, [=body =rest])) parser
  | RES_PARSER rest | COMPLETE_RES statusLine headers body


> ResParser > Bar > ResParser
= (feedResData parser newData)
@ cum | getAccumulated parser
| stepResParser | setAccumulated (barWeld cum newData) parser


> ResParser > Maybe (Either Bar HTTPResponse)
= (getResponse parser)
# datacase | getState parser
* _                | NONE
* PARSER_ERROR|msg | SOME LEFT-msg
* (COMPLETE_RES (version,code,reason) headers body)
^ SOME | RIGHT _
| HTTP_RES
* version
* code
* reason
* headers
* body
