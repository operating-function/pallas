;; Run using either one of the following (or other combos):
;; pallas start /path/to/ship --opt foo=hello --opt bar=420
;; pallas start /path/to/ship --opt foo=hello --opt bar
;; pallas start /path/to/ship --opt foo
;; pallas start /path/to/ship
;;
;; Options with a value will return (SOME valueAsBar).
;; Options that lack a value will return (SOME b#{}).
;; Missing options will return NONE.

#### cli_opts <- kern

:| kern

= (driver return)
: foo < launch | CLI_OPT b#foo
: bar < launch | CLI_OPT b#bar
| trk , driver [=foo =bar]
| return ()

= (cog return)
: _ < install driver die die
| return ()

= main | runCog 0 cog
