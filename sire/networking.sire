#### networking <- driver_http

:| sire
:| blake3 [blake3]
:| lib_http [barSplitOnSubstring]

= OUR         | b#vinney
= SECRET      | b#secret
= SHOULD_AUTH | TRUE

= NAME_SERVER_DOMAIN
| b#{localhost:8000}

= NAME_SERVER_GET
| barCat [b#{http://} NAME_SERVER_DOMAIN b#{/users}]

= NAME_SERVER_POST
| barCat [b#{http://} NAME_SERVER_DOMAIN b#{/announce}]

= NAME_SERVER_ADDR
| (16777343, 8000)

= (ipToNat bar)
@ bytes | barSplit {.} bar
| maybeGuard (listLen bytes == 4)
: nats
  < ^ traverseList _ bytes
    & (byte return)
    : n < bindMaybe | parseNat byte
    | maybeGuard | lth n 256
    | return n
^ SOME | listSum | listZipWith mul nats _
| listMap pow-256 ~[0 1 2 3]


=?= SOME-16777343  | ipToNat b#{127.0.0.1}
=?= SOME-612615823 | ipToNat b#{143.198.131.36}
=?= NONE           | ipToNat b#{143.1.1}
=?= NONE           | ipToNat b#{143.1.1.1.1}
=?= NONE           | ipToNat b#{foo}

= (splitURL url)
: (protocol,address) < bindMaybe | barSplitOnSubstring b#{//} url
@ (domain,path) | barSplitOne {/} address
| SOME (domain, barWeld b#{/} path)

=?= SOME-(NAME_SERVER_DOMAIN, b#{/users})
  | splitURL NAME_SERVER_GET


# record BlockHasher
| BLOCK_HASHER
* hash : Bar > Bar  ; hash function
* blockSize : Nat   ; block size in bytes

> BlockHasher
= blake3_64 | BLOCK_HASHER blake3 64

> BlockHasher > Bar > Bar > Bar
= (hmac hf key message)
@ bSize | getBlockSize hf
@ hashF | getHash hf
@ keyPadded
  | if (gth (barLen key) bSize) | hashF key
  | barWeld key | barRep 0 | sub bSize (barLen key)
@ opad | barMap (mix 0x5c) keyPadded
@ ipad | barMap (mix 0x36) keyPadded
| hashF | barWeld opad | hashF | barWeld ipad message

> BlockHasher > Bar > Bar > Bar > Bit
= (verifyHMAC hf key message)
| eql | hmac hf key message

!! | verifyHMAC blake3_64 b#key b#message
   | hmac blake3_64 b#key b#message

!! | not | verifyHMAC blake3_64 b#key b#message
         | hmac blake3_64 b#key b#MESSAGE

= (authenticate headers now key)
| ifNot SHOULD_AUTH | TRUE
@ timeBar | tabGet headers b#time
: time < bindMaybe | parseNat timeBar
| trk , authenticate [=headers =now =key =time =timeBar]
| and ((lte (sub now 60) time) && (lte time (add now 60)))
| verifyHMAC blake3_64 key timeBar
| tabGet headers b#mac

!! | ifNot SHOULD_AUTH | TRUE
   ^ authenticate _ 5000 b#secret
   @ timeBar b#5060
   | tabFromPairs
   ++ , b#time timeBar
   ++ , b#mac  (hmac blake3_64 b#secret timeBar)

!! | ifNot SHOULD_AUTH | TRUE
   ^ not | authenticate _ 5000 b#secret
   @ timeBar b#5061
   | tabFromPairs
   ++ , b#time timeBar
   ++ , b#mac  (hmac blake3_64 b#secret timeBar)

!! | ifNot SHOULD_AUTH | TRUE
   ^ authenticate _ 5000 b#secret
   @ timeBar b#4940
   | tabFromPairs
   ++ , b#time timeBar
   ++ , b#mac  (hmac blake3_64 b#secret timeBar)

!! | ifNot SHOULD_AUTH | TRUE
   ^ not | authenticate _ 5000 b#secret
   @ timeBar b#4939
   | tabFromPairs
   ++ , b#time timeBar
   ++ , b#mac  (hmac blake3_64 b#secret timeBar)
