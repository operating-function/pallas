#### driver_hermes <- driver_http_client

:| kern
:| pinhash
:| lib_http [DOUBLE_CRLF barSplitOnSubstring]

;; TODO move BiMap somewhere

# record (BiMap k v)
| BI_MAP  
* forward  : Tab k v    ; name -> (socket,ip,port)
* backward : Tab v k    ; (ip,port) -> (socket,name)

> k > v > BiMap k v > Bit  
= (biMapHas k v bimap)
| and (tabHas k | getForward bimap)
     (tabHas v | getBackward bimap)

> k > BiMap k v > Bit
= (biMapHasForward k bimap)
| tabHas k | getForward bimap

> v > BiMap k v > Bit
= (biMapHasReverse v bimap) 
| tabHas v | getBackward bimap

> k > BiMap k v > Maybe v
= (biMapLookup k bimap)    
| tabLookup k | getForward bimap

> v > BiMap k v > Maybe k
= (biMapReverseLookup v bimap)
| tabLookup v | getBackward bimap

> BiMap k v
= emptyBiMap
| BI_MAP #[] #[]

> k > v > BiMap k v > BiMap k v
= (biMapInsert k v bimap)
@ forward  | tabIns k v | getForward bimap
@ backward | tabIns v k | getBackward bimap  
| BI_MAP forward backward

> k > BiMap k v > BiMap k v
= (biMapDelete k bimap)
: v < maybeCase (tabLookup k | getForward bimap) bimap
@ forward  | tabDel k | getForward bimap
@ backward | tabDel v | getBackward bimap
| BI_MAP forward backward

> v > BiMap k v > BiMap k v  
= (biMapDeleteReverse v bimap)
: k < maybeCase (tabLookup v | getBackward bimap) bimap
@ forward  | tabDel k | getForward bimap
@ backward | tabDel v | getBackward bimap
| BI_MAP forward backward

> BiMap k v > Row k
= (biMapKeys bimap)
| tabKeysRow | getForward bimap

> BiMap k v > Row v 
= (biMapVals bimap)
| tabValsRow | getForward bimap


;;;;;;;

= (makeMessage plan)
@ seed | _SaveSeed plan
^ barWeld _ seed
| natToSizedBar 4 | barLen seed


# datatype ParserState
* AWAITING_SIZE
* AWAITING_SEED len:Nat
* PARSER_ERROR  err:Bar

# record HermesParser
| HERMES_PARSER
* queue : Bar
* msgs  : List Any
* state : ParserState

= newHermesParser
| HERMES_PARSER
* emptyBar
* NIL
* AWAITING_SIZE


> HermesParser > Maybe (Nat, Bar)
= (processSize parser)
@ HERMES_PARSER(..) parser
# datacase state
* _ | NONE
* AWAITING_SIZE
| maybeGuard (gte (barLen queue) 4)
@ (sz,rest) | barSplitAt 4 queue
| SOME (barNat sz, rest)


= (processSeed parser)
@ HERMES_PARSER(..) | parser
# datacase state
* _ | NONE
* (AWAITING_SEED size)
| maybeGuard | lte size | barLen queue
| SOME | barSplitAt size queue


= (stepParser parser)
@ HERMES_PARSER(..) parser
# datacase state
* AWAITING_SIZE
  : (size,rest) < maybeCase (processSize parser) parser
  | stepParser
  | HERMES_PARSER rest msgs | AWAITING_SEED size
* (AWAITING_SEED size)
  : (seed,rest) < maybeCase (processSeed parser) parser
  | stepParser
  | HERMES_PARSER rest (_LoadSeed seed)::msgs AWAITING_SIZE

= (feedData parser newData)
@ queue | getQueue parser
| stepParser | setQueue (barWeld queue newData) parser


=?= | HERMES_PARSER emptyBar ~[{foo}] AWAITING_SIZE
  | feedData newHermesParser
  | makeMessage {foo}

= (msgId bar) | barTake 4 | planHash bar

= (inbox socket msgHandler return)
^ _ newHermesParser
? (go parser)
: data < launch | TCP_TAKE socket
| if (barIsEmpty data)
  | trk , inbox %connection_closed [=socket]
  | return ()
| trk , inbox [tookChunk=(msgId data) =socket]
@ newParser | feedData parser data
: _ < ^ traverseList _ | getMsgs newParser
      & msg | trk inbox,[tookMsg=(msgId msg)] | msgHandler msg
| go (setMsgs ~[] newParser)


= (outbox return)
: (name,msg) < listen
| trk , outbox [gotMsg=(msgId msg) to=name]
: _          < fork outbox
: mAddr      < launch | DB_READ | biMapLookup name
: (ip,port)  < maybeCase mAddr
             | trk , outbox %ignoring_no_such_peer [=name =msgId]
             | return ()
: mSocket    < launch | TCP_OPEN ip port
: socket     < maybeCase mSocket
             | trk , outbox %failed_to_connect [=name =ip =port =msgId]
             | return ()
| trk , outbox %sending [=socket msgId=(msgId msg) size=(barLen | makeMessage msg) to=(ip,port)]
^ _ | makeMessage msg
? (go bar)
: mBytes < launch | TCP_GIVE socket bar
: bytes < maybeCase mBytes
        | trk , outbox %closed [=socket]
        | launch (TCP_SHUT socket) return
| trk , outbox %sent [sentChunk=(msgId | barTake bytes bar) =bytes]
| if bytes/=(barLen bar) | go | barDrop bytes bar
| trk , outbox [finished=(msgId msg)]
| launch (TCP_SHUT socket) return


= (makeHermes msgHandler return)
: _ < fork outbox
: port < launch | TCP_MINE
: _ < launch_ | DB_WRITE (%PORT, port)
| trk , makeHermes [=port]
^ _ return
? (go return)
: (socket,ip,port) < launch TCP_HEAR
| trk , makeHermes %connection_from [=ip =port =socket]
;; : known < launch | DB_READ | biMapHasReverse addr
;; | ifNot known
;;   | trk [%connection_from_nonpeer addr]
;;   : _ < launch | TCP_SHUT socket
;;   | go return
: _ < fork | inbox socket msgHandler
| go return

= (requestHandler (cmd,msg) return)
# switch cmd
* PRINT | trk [%got_from_remote msg] | return ()
* NAME
| trk , requestHandler [newName=msg]
: _ < launch_ | DB_WRITE (%CDX, msg)
| return ()


= (writeHandler _ (name,addr))
| trk , writeHandler [=name =addr]
| modifyState | biMapInsert name addr


