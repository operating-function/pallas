;; Things to optimize
;; - warcBlocks could insert instead of rowConsing. But then then we need
;;   to actually build the CDX in the same step because that how we merge/cmp.
;; - Be more aggressive with eval/work, but remember atomicity.
#### warc <- driver_hermes

:| kern
:| networking
:| driver_http
:| driver_http_client
:| driver_hermes [makeHermes emptyBiMap biMapInsert biMapKeys]

# abstype Ord
# backfill EQ Ord
# backfill LT Ord
# backfill GT Ord


= (barReplaceAll old new bar)
| barIntercalateList new | barSplit old bar

=?= b#{hello-world}   | barReplaceAll {_} b#{-} b#{hello_world}
=?= b#{hello_world}   | barReplaceAll {-} b#{_} b#{hello_world}
=?= b#{helloworld}    | barReplaceAll {_} b#{} b#{hello_world}
=?= b#{hello-=-world} | barReplaceAll {_} b#{-=-} b#{hello_world}


;; Saved for historical reasons? Would be nice to create the list
;; operation from the row operation kind of like `rowPort` but in reverse.
= (listMerge left right cmp merge)
: x xs < listCase left right
: y ys < listCase right left
@ res | cmp x y
| if res==LT |           x::(listMerge xs   right cmp merge)
| if res==GT |           y::(listMerge left ys    cmp merge)
| else       | (merge x y)::(listMerge xs   ys    cmp merge)

;; Merges two sorted rows using a comparision function and a merge function.
;; Note that the result might be shorter than the sum of the input lengths,
;; since if two elements compare to EQ, they will be merged.
> Row Any > Row Any > (Any > Any > Ord) > (Any > Any > Any) > Row Any
= (merge left right cmd mergeFun)
@ lenL | len left
@ lenR | len right
^ _ 0 0 0 | rep 0 | add lenL lenR
? (go idxL idxR idx result)
| if (gte idxL lenL) | weld (take idx result) (drop idxR right)
| if (gte idxR lenR) | weld (take idx result) (drop idxL left)
@ elemL | get left  idxL
@ elemR | get right idxR
@ res   | cmp elemL elemR
| if res==LT | go inc-idxL idxR inc-idx | put result idx elemL
| if res==GT | go idxL inc-idxR inc-idx | put result idx elemR
| go inc-idxL inc-idxR inc-idx | put result idx | mergeFun elemL elemR

=?= [1 2 3 4 5 6]     | merge [1 3 5] [2 4 6] cmp const
=?= [1 2 3 4 5]       | merge [1 2 3] [2 4 5] cmp const
=?= [1 2 3]           | merge [1 2 3] [] cmp const
=?= [1 2 3]           | merge [] [1 2 3] cmp const
=?= []                | merge [] [] cmp const
=?= [1 2 3 4]         | merge [1 2] [3 4] cmp const
=?= [1 4 3 4 5]       | merge [1 2 4] [2 3 5] cmp add
=?= [1 6 5]           | merge [1 3] [3 5] cmp add
=?= [1 4 6 5]         | merge [1 2 3] [2 3 5] cmp add

> (Any > Any > Ord) > (Any > Any > Any) > Row Any > Row Any
= (mergeSort cmp mergeFun xs)
@ len | len xs
| if (lte len 1) | xs
@ mid   | div len 2
@ left  | take mid xs
@ right | drop mid xs
| merge
* mergeSort cmp mergeFun left
* mergeSort cmp mergeFun right
* cmp
* mergeFun

=?= []                | mergeSort cmp const []
=?= [1]               | mergeSort cmp const [1]
=?= [1 2 3 4 5]       | mergeSort cmp const [5 4 3 2 1]
=?= [1 2 3 4 5]       | mergeSort cmp const [3 1 5 2 4]
=?= [1 2 3 4 5]       | mergeSort cmp const [3 1 5 3 2 4]
=?= [1 {a} {b}]       | mergeSort cmp const [{b} {a} 1]
=?= [1 4 4 5]         | mergeSort cmp add [2 1 2 4 5]
=?= [1 4 6]           | mergeSort cmp add [2 2 3 3 1]

# record EntryMetadata
| ENTRY_METADATA
* recordType     : Bar
* metaTimestamp  : Bar
* targetURI      : Maybe Bar
* concurrentTo   : Maybe Bar
* recordID       : Maybe Bar
* httpStatus     : Maybe Nat
* httpLocation   : Maybe Bar
* httpContentType: Maybe Bar
* metaBaseUrl    : Maybe Bar


# record WARCLocation
| WARC_LOC
* nodeName : Bar
* offset   : Nat

# record CDXEntry
| CDX_ENTRY
* canonicalUrl : Bar
* timestamp    : Bar
* originalUrl  : Bar
* mimeType     : Bar
* responseCode : Nat
* record       : Either Bar (Pin Bar)  ; LEFT is hash, RIGHT is the actual record
* redirectUrl  : Bar
* robotsTags   : Bar
* length       : Nat
* baseUrl      : Bar
* sources      : Row WARCLocation

> EntryMetadata > Bar
= (makeMimeType meta)
# switch (getRecordType meta)
* b#revisit  | b#{warc/revisit}
* b#request  | b#{-}
* b#response | maybeCase (getHttpContentType meta) b#unk | barReplaceAll { } b#{}
* _          | b#unk

= (getDigest cdx)
: pinRec < flip fromLeft | getRecord cdx
| barWeld b#{b3:} | barToHex | pinHash pinRec

=?= x#deadbeef
  | getDigest
  | CDX_ENTRY
  * b#{test}
  * b#{test}
  * b#{test}
  * b#{test}
  * 200
  * LEFT x#deadbeef
  * b#{test}
  * b#{test}
  * 100
  * b#{test}
  * []

=?= | barWeld b#{b3:} | barToHex | planHash x#deadbeef
  | getDigest
  | CDX_ENTRY
  * b#{test}
  * b#{test}
  * b#{test}
  * b#{test}
  * 200
  * RIGHT | PIN x#deadbeef
  * b#{test}
  * b#{test}
  * 100
  * b#{test}
  * []

> EntryMetadata > Nat
= (makeStatus meta)
# switch (getRecordType meta)
* b#response | fromSome 0 | getHttpStatus meta
* _          | 0

> EntryMetadata > Maybe EntryMetadata > EntryMetadata
= (findPreferredHeaders m0 mm1)
: m1 < maybeCase mm1 m0
# switch | getRecordType m0
* b#response | m0
* b#revisit  | if (getRecordType-m1 == b#response) m1 m0
* _          | m1


> EntryMetadata > EntryMetadata > Bit
= (shouldCombine m1 m2)
| and (getTargetURI m1 == getTargetURI m2)
@ t1 (getRecordType m1) 
@ t2 (getRecordType m2)
| if ((t1 == b#request) && ((t2 == b#response) || (t2 == b#revisit)))
  | (getConcurrentTo-m2 == getRecordID-m1)
| if ((t2 == b#request) && ((t1 == b#response) || (t1 == b#revisit))) 
  | (getConcurrentTo-m1 == getRecordID-m2) 
| FALSE

= (combine m0 mm1)
: m1 < maybeCase mm1       | RIGHT m0
| if (shouldCombine m0 m1) | RIGHT | findPreferredHeaders m0 mm1
| LEFT m1


> Tab Bar Bar > Tab Bar Bar > Maybe Nat > Maybe EntryMetadata 
= (makeMetadata warcHeaders httpHeaders mCode)
: recordType    < bindMaybe | tabLookup b#{WARC-Type} warcHeaders
: timestamp     < bindMaybe | tabLookup b#{WARC-Date} warcHeaders
| SOME
| ENTRY_METADATA
* recordType
* timestamp
* tabLookup b#{WARC-Target-URI} warcHeaders 
* tabLookup b#{WARC-Concurrent-To} warcHeaders
* tabLookup b#{WARC-Record-ID} warcHeaders
* mCode
* tabLookup b#{location} httpHeaders
* tabLookup b#{content-type} httpHeaders
* tabLookup b#{Base-URL} warcHeaders


> CDXEntry > CDXEntry
= (cdxToRef cdx)
; Convert a CDX entry with record (RIGHT) to one with hash only (LEFT)
| setRecord (LEFT | getDigest cdx) cdx

