= sampleWarcHeaders
| tabFromPairs
++ , b#{WARC-Type} b#{response}
++ , b#{WARC-Date} b#{2024-01-01T00:00:00Z}

= sampleHttpHeaders  
| tabSing b#{content-type} b#{text/html}

=?= | makeMetadata sampleWarcHeaders sampleHttpHeaders SOME-200
  | SOME
  | ENTRY_METADATA
  * b#response
  * b#{2024-01-01T00:00:00Z}
  * NONE
  * NONE  
  * NONE
  * SOME 200
  * NONE
  * SOME b#{text/html}
  * NONE

=?= NONE
  | makeMetadata
  * tabDel b#{WARC-Type} sampleWarcHeaders
  * sampleHttpHeaders
  * NONE

=?= NONE
  | makeMetadata  
  * tabDel b#{WARC-Date} sampleWarcHeaders
  * sampleHttpHeaders
  * NONE


> List Bar > Tab Bar Bar
= (parseLinesIntoHeaders lines)
^ listFoldl _ #[] lines
? (go acc line)
@ [key val] | barSplitOne {:} line
@ key | barTrim key
@ val | barTrim val
| tabIns key val acc

=?= | tabFromPairs [(b#Key1, b#Val1) (b#Key2, b#Val2)]
  | parseLinesIntoHeaders ~[b#{Key1: Val1} b#{Key2: Val2}]


> Bar > Maybe (Nat, Tab Bar Bar, Bar)
= (parseWarcHeaders bar)
@ magic | barTake 8 bar
| if ((barTake 8 bar) /= b#{WARC/1.1}) | NONE ;; TODO deal with different versions
; Skip CRLF after magic
@ pos | 10
: (wHead,rest) < bindMaybe | barSplitOnSubstring DOUBLE_CRLF | barDrop pos bar
@ warcHeaders | parseLinesIntoHeaders | barSubstringLinesList CRLF wHead
| SOME (add pos (add 4 barLen-wHead), warcHeaders, rest)


> Bar > (Maybe Nat, Tab Bar Bar)
= (parseHttpHeaders bar)
@ error | (NONE, emptyTab)
: (headBlock,_)    < maybeCase (barSplitOnSubstring DOUBLE_CRLF bar) | error
: (respLine,hHead) < maybeCase (barSplitOnSubstring CRLF headBlock)  | error ;; TODO too greedy
@ mCode
  @ codeBar | listIdx 1 | barSplit { } respLine
  | parseNat codeBar
@ heads | parseHeaders hHead
| (mCode,heads)

> Bar > Maybe (EntryMetadata, Nat)
= (getNextRecord bar)
: (headLen,warcHeaders,rest) < bindMaybe | parseWarcHeaders bar
: length                     < bindMaybe | tabLookup b#{Content-Length} warcHeaders
: length                     < bindMaybe | parseNat length
@ (mCode,httpHeaders)                    | parseHttpHeaders | barTake length rest
: meta                       < bindMaybe | makeMetadata warcHeaders httpHeaders mCode
| SOME (meta, add headLen length)


= tinyRecord
| barIntercalate CRLF
++ # b } WARC/1.1
++ # b } WARC-Type: request
++ # b } WARC-Date: 2016-09-19T17:20:24Z
++ # b } Content-Length: 55
++ # b } 
++ # b } GET /index.html HTTP/1.0
++ # b } Host: http://example.com/
++ CRLF

=?= SOME-(barLen tinyRecord)
  ^ fmapMaybe _ snd
  | getNextRecord tinyRecord

= requestMeta
| ENTRY_METADATA
* b#{request}
* b#{2016-09-19T17:20:24Z}
* SOME b#{http://www.archive.org/images/logoc.jpg}
* NONE
* SOME b#{<urn:uuid:92283950-ef2f-4d72-b224-f54c6ec90bb0>}
* NONE
* NONE
* NONE
* SOME b#{http://www.archive.org/}

= responseMeta
| ENTRY_METADATA  
* b#{response}
* b#{2016-09-19T17:20:24Z}
* SOME b#{http://www.archive.org/images/logoc.jpg} 
* SOME b#{<urn:uuid:92283950-ef2f-4d72-b224-f54c6ec90bb0>}
* SOME b#{<urn:uuid:4885803b-eebd-4b27-a090-144450c11594>}
* SOME 200
* NONE
* SOME b#{image/jpeg}
* SOME b#{http://www.archive.org/}

= revisitMeta 
| ENTRY_METADATA
* b#{revisit}
* b#{2017-06-23T12:43:35Z}
* SOME b#{http://www.archive.org/images/logoc.jpg}
* NONE
* SOME b#{<urn:uuid:16da6da0-bcdc-49c3-927e-57494593bbbb>}
* SOME 304
* NONE
* NONE
* SOME b#{http://www.archive.org/}

=?= | getNextRecord requestRecord
  | SOME (requestMeta, barLen requestRecord) 

=?= | getNextRecord responseRecord
  | SOME (responseMeta, barLen responseRecord)

=?= | getNextRecord revisitRecord
  | SOME (revisitMeta, barLen revisitRecord)

=?= | getNextRecord | barCat [requestRecord responseRecord revisitRecord]
  | SOME (requestMeta, barLen requestRecord) 


> Bar > Row (Nat, Nat, EntryMetadata)
= (warcBlocks warcFile)
^ _ 0 0 NONE []
? (go off pos mPrev acc)
@ loc | add off pos
: (meta, recLen) < maybeCase | getNextRecord | barDrop loc warcFile
                 : prev < maybeCase mPrev acc
                 | rowCons (off,pos,prev) acc
: newMeta < eitherCase | combine meta mPrev
          & old
          | go loc recLen (SOME meta) | rowCons (off,pos,old) acc
| go off (add pos recLen) (SOME newMeta) acc

=?= [(0, barLen requestRecord, requestMeta)]
  | warcBlocks requestRecord

=?= [(0, barLen responseRecord, responseMeta)]
  | warcBlocks responseRecord

=?= [(0, barLen (barWeld requestRecord responseRecord), responseMeta)]
  | warcBlocks | barWeld requestRecord responseRecord


= (canonicalize url)
: (scheme,rest) < maybeCase (barSplitOnSubstring b#{://} url) url
@ (address,path) | barSplitOne {/} rest
@ (domain,port)  | barSplitOne {:} address
@ address | if (port == b#{80}) domain address
@ norm | barMap toLower | barCat [scheme b#{://} address]
@ path | if barIsEmpty-path b#{} | barWeld b#{/} path
| barReplaceAll 0x0d b#{%0D}
| barReplaceAll 0x0a b#{%0A} 
| barReplaceAll 0x09 b#{%09}
;; | barReplaceAll b#{:80/} b#{/} ;; TODO fix types here
| barWeld norm path

=?= b#{http://example.com/path}
  | canonicalize b#{HTTP://EXAMPLE.com:80/path}

=?= b#{http://example.com/Path/camelCase}
  | canonicalize b#{HTTP://EXAMPLE.com/Path/camelCase}

=?= b#{http://example.com}
  | canonicalize b#{HTTP://EXAMPLE.com:80}

=?= b#{not-a-url} 
  | canonicalize b#{not-a-url}

=?= b#{http://example.com/foo%09bar%0A}
  | canonicalize | barCat [b#{HTTP://example.com/foo} (barSing 0x09) b#bar barNewline]


= (cmpCDX x y)
@ (cmpOn f) | cmp f-x f-y
| ordWeld | cmpOn getCanonicalUrl
| ordWeld | cmpOn getTimestamp
| ordWeld | cmpOn getDigest
| ordWeld | cmpOn getOriginalUrl
| ordWeld | cmpOn getMimeType
| ordWeld | cmpOn getResponseCode
| ordWeld | cmpOn getRedirectUrl
| ordWeld | cmpOn getBaseUrl
| cmpOn getLength

=?= EQ | cmpCDX sampleCDX1 sampleCDX2
=?= GT | cmpCDX sampleCDX1 sampleCDX3
=?= LT | cmpCDX sampleCDX3 sampleCDX1

= (mergeCDX x y)
^ setSources _ x
| merge getSources-x getSources-y cmp const

=?= [(WARC_LOC b#1 100) (WARC_LOC b#2 200)]
  | getSources | mergeCDX sampleCDX1 sampleCDX2

=?= | take (dec | len sampleCDX1) sampleCDX1
  | take (dec | len sampleCDX1) | mergeCDX sampleCDX1 sampleCDX2


> Bar > Bar > Row CDXEntry
= (buildCDX our warcFile)
| mergeSort cmpCDX mergeCDX
: (off,len,meta) < foreach | warcBlocks warcFile
@ content | barSlice off (add off len) warcFile
@ url     | fromSome b#{} | getTargetURI meta
@ status  | makeStatus meta
@ redirectUrl
  | ifNot ((lte 300 status) && (lth status 400)) b#{-}
  | fromSome b#{-} | getHttpLocation meta
| CDX_ENTRY
* canonicalize url
* getMetaTimestamp meta
* url
* makeMimeType meta
* status
* RIGHT | PIN content
* redirectUrl
* b#{-} ;; don't parse robots.txt for now
* len
* fromSome b#{-} | getMetaBaseUrl meta
* [(WARC_LOC our off)]

=?= | buildCDX b#our | barWeld requestRecord responseRecord
  ^ [_]
  | CDX_ENTRY
  * canonicalize | fromSome b#{} | getTargetURI responseMeta
  * getMetaTimestamp responseMeta
  * fromSome b#{} | getTargetURI responseMeta
  * makeMimeType responseMeta
  * makeStatus responseMeta
  * RIGHT | PIN (barWeld requestRecord responseRecord)
  * fromSome b#{-} | getHttpLocation responseMeta
  * b#{-}
  * barLen | barWeld requestRecord responseRecord
  * fromSome b{-} | getMetaBaseUrl requestMeta
  * [(WARC_LOC b#our 0)]

= reqres
| barWeld requestRecord responseRecord

=?= 2
  ^ len | buildCDX emptyBar | barCat _
  [requestRecord responseRecord differentUrlRecord]

=?= 2
  ^ len | buildCDX emptyBar | barCat _
  [requestRecord responseRecord revisitRecord]

=?= 3
  ^ len | buildCDX emptyBar | barCat _
  [requestRecord revisitRecord responseRecord]

=?= 3
  ^ len | buildCDX emptyBar | barCat _
  [requestRecord responseRecord revisitRecord differentUrlRecord]

=?= 4
  ^ len | buildCDX emptyBar | barCat _
  [requestRecord revisitRecord responseRecord differentUrlRecord]


= (offset off cdx)
^ setSources _ cdx
: @(WARC_LOC ship loc) < foreach | getSources cdx
| WARC_LOC ship | add loc off

=?= [(WARC_LOC b#1 200)]
  | getSources | offset 100 sampleCDX1


> CDXEntry > Bar
= (serializeCDX cdx)
| barIntercalate b#{ }
++ getCanonicalUrl cdx
++ getTimestamp cdx
++ getOriginalUrl cdx
++ getMimeType cdx
++ ^ ifz _ b#{-} | printNat _
   | getResponseCode cdx
++ getDigest cdx
++ getRedirectUrl cdx
++ getRobotsTags cdx
++ ^ ifz _ b#{-} | printNat _
   | getLength cdx
++ getBaseUrl cdx
++ barCat
  ++ | barIntercalateList b#{|}
     : (name,off) < foreach | getSources cdx
     | barCat [name b#{:} (printNat off)]
  ++ barNewline


=?= | serializeCDX sampleCDX1 
  ^ barWeld _ barNewline
  | barIntercalate b#{ }
  ++ b#{http://example.com}
  ++ b#{20240101000000}
  ++ b#{http://example.com}
  ++ b#{text/html}
  ++ b#{200}
  ++ getDigest sampleCDX1
  ++ b#{-}
  ++ b#{-}
  ++ b#{100}
  ++ b#{http://example.com}
  ++ b#{1:100}

# record WhitelistEntry
| WHITELIST_ENTRY
* prefix : Bit

# record WARCState
| WARC_STATE
* cdxs       : Tab Bar CDXEntry  ; Store CDX entries by their content hash
* names      : BiMap Bar (Nat, Nat)
* hermesPort : Maybe Nat
* httpPort   : Maybe Nat
* whitelist  : Tab Str WhitelistEntry
* secretKey  : Maybe Bar
* our        : Maybe Bar

= emptyWarcState
| WARC_STATE emptyTab emptyBiMap NONE NONE emptyTab NONE NONE

= (parseWhite bar)
@ (entries,_) | parseJson bar
| maybeGuard (isTab entries)
@ newWhitelist
  ^ tabFoldlWithKey _ emptyTab entries
  & (acc url entry)
  @ url | canonicalize url
  | fromSome acc
  : prefix < bindMaybe | tabLookup %prefix entry
  # datacase prefix
  * _ | NONE
  * JTRUE  | SOME | tabIns url [TRUE] acc
  * JFALSE | SOME | tabIns url [FALSE] acc
| maybeGuardNot (tabIsEmpty newWhitelist)
| SOME newWhitelist

=?= | SOME [{https://example.com}=[TRUE]]
  | parseWhite b#{{"https://example.com": {"prefix": true}}}

=?= | SOME [{https://example.com}=[TRUE]]
  | parseWhite
  b#{{"https://example.com": {"prefix": true, "extra": {"field": "value"}}}}

=?= | SOME
    ## ={https://example1.com} [TRUE]
    ## ={https://example2.com} [FALSE]
  | parseWhite
  # b
  } { "https://example1.com": {"prefix": true},
  } "https://example2.com": {"prefix": false} }

!! isNone | parseWhite b#{{}}
!! isNone | parseWhite b#{{"https://example.com": {"other_field": true}}}
!! isNone | parseWhite b#{{"https://example.com": {"prefix": "invalid"}}}
!! isNone | parseWhite b#{invalid json}

= (printWhitelist white)
^ printJson | JMAP | tabMap _ white
& [prefix]
## =prefix | if prefix JTRUE JFALSE

=?= b#{{"https://example.com":{"prefix":true}}}
  ^ bindMaybe (parseWhite _) printWhitelist
  b#{{"https://example.com": {"prefix": true, "extra": {"field": "value"}}}}


> Tab Str WhitelistEntry > CDXEntry > Bit
= (isPublic whitelist cdx)
@ CDX_ENTRY(..) cdx
@ urls [canonicalUrl originalUrl redirectUrl baseUrl]
^ not | tabIsEmpty _
: url WHITELIST_ENTRY(..) < flip tabFilterWithKey whitelist
@ url         | natBar url
@ urlMatch    | any (eql url) urls
@ prefixMatch | any (flip (barIsPrefixOf url) 0) urls
| (urlMatch || (prefix && prefixMatch))


= exactUrlCDX
| CDX_ENTRY
* b#{http://example.com}     ; canonical
* b#{}                       ; timestamp
* b#{http://example.com}     ; original
* b#{}                       ; mime
* 200                        ; status
* b#{}                       ; digest
* b#{http://redirect.com}    ; redirect
* b#{}                       ; robots
* 0
* b#{http://example.com}
* []

= prefixCDX
| CDX_ENTRY
* b#{http://sub.example.com/path}
* b#{}
* b#{http://sub.example.com/path}
* b#{}
* 200
* b#{}
* b#{}
* b#{}
* 0
* b#{}
* []


= exampleWhitelist
## ={http://example.com} | WHITELIST_ENTRY FALSE
## ={http://prefix.com}  | WHITELIST_ENTRY TRUE

!! isPublic exampleWhitelist exactUrlCDX

!! not | isPublic exampleWhitelist prefixCDX

!! isPublic exampleWhitelist | setRedirectUrl b#{http://example.com} prefixCDX

!! | isPublic exampleWhitelist
   | setCanonicalUrl b#{http://prefix.com/foo} exactUrlCDX

!! | isPublic exampleWhitelist
   @ url b#{http://blocked.com}
   | setOriginalUrl url | setCanonicalUrl url exactUrlCDX

= (addCDXs newCDXs st)
^ setCdxs _ st
^ foldl _ (getCdxs st) newCDXs
& (tab cdx)
| tabIns (getDigest cdx) cdx tab

=?= (tabSing (getDigest sampleCDX1) sampleCDX1)
  | getCdxs | addCDXs [sampleCDX1] emptyWarcState

=?= (tabIns (getDigest sampleCDX3) sampleCDX3 (tabSing (getDigest sampleCDX1) sampleCDX1))
  | getCdxs | addCDXs [sampleCDX1 sampleCDX3] emptyWarcState

= sampleCDX1Modified
| setLength 150 sampleCDX1

=?= (tabSing (getDigest sampleCDX1) sampleCDX1Modified)
  | getCdxs | addCDXs [sampleCDX1 sampleCDX1Modified] emptyWarcState


> HTTPRequest > Driver (Tab Bar Bar, Bar, Nat, Bar)
= (requestHandler req@[method path version headers body] return)
@ (auth action)
  : now       < launch TIME_WHEN
  : secretKey < launch | DB_READ [%SECRET]
  | if (authenticate headers now secretKey)
    | action
  | return [emptyTab emptyBar 403 b#forbidden]
@ badRequest [emptyTab b#{} 400 b#{bad}]
@ warc_head | tabSing b#{content-type} b#warc
@ cdxs_head | tabSing b#{content-type} b#{x-cdx}
@ json_head | tabSing b#{content-type} b#{application/json}
# switch method
* _ | return badRequest
* GET
  @ [path query] | barSplitOne {?} path
  # switch path
  * _ | return badRequest
  * b#{/whitelist}
    | auth
    : json < launch | DB_READ [%WHITELIST]
    | return [json_head json 200 b#gotcha]
  * b#{/print}
    : _ < launch | DB_READ [%PRINT]
    | return [emptyTab emptyBar 200 b#gotcha]
  * b#{/index}
    | auth
    : cdxs < launch | DB_READ [%INDEX]
    | return [cdxs_head (barCat | map serializeCDX cdxs) 200 b#gotcha]
  * b#{/read}
    : now < launch TIME_WHEN
    @ authFun | authenticate headers now
    @ params  | tabFromPairsList | listMap barSplitOne-{=} | barSplit {&} query
    @ digest | tabGet params b#digest
    : res    < launch | DB_READ (%READ, digest, authFun)
    : bar    < eitherCase res (code,err)&(return [emptyTab emptyBar code err])
    | return [warc_head bar 200 b#gotcha]
* POST
  | auth
  # switch path
  * _ | return badRequest
  * b#{/warc}
    : cdxs < launchWith & rid | DB_WRITE (%WARC, (rid, body))
    | return [cdxs_head (barCatList | map serializeCDX cdxs) 200 b#gotcha]
  * b#{/update-whitelist}
    : json < launchWith & rid | DB_WRITE (%WHITELIST, (rid, body))
    | return [json_head json 201 b#updated]


= (trkState @WARC_STATE(..))
^ trk _ 0
@ warcSize | sum | map getLength | tabValsRow cdxs
@ cdxBarSize 
  | sum
  : @CDX_ENTRY(..) < foreach | tabValsRow cdxs
  ^ sum | map barLen _
  ++ canonicalUrl
  ++ timestamp
  ++ originalUrl
  ++ mimeType
  ++ redirectUrl
  ++ robotsTags
  ++ baseUrl
  ++ sum | foreach sources (@WARC_LOC(..))&(barLen nodeName)
  ++ eitherCase record barLen _&0
## =cdxEntries | tabLen cdxs
## =names      | fst names
## =hermesPort
## =httpPort
## =whited     | tabLen whitelist
## =warcSize   | warcSize
## =totalState | add warcSize cdxBarSize


= (readHandler st@WARC_STATE(..) query)
# switch fst-query
* PRINT     | trkState st
* INDEX     | tabValsRow cdxs  ; Get all CDX entries from the tab
* WHITELIST | printWhitelist whitelist
* SECRET    | secretKey
* READ
@ (_,digest,authFun) | query
: cdx      < maybeCase (tabLookup digest cdxs) | LEFT [404 b#{not found}]
@ public   | isPublic whitelist cdx
@ auth     | authFun secretKey
| ifNot (auth || public) | LEFT [403 b#forbidden]
: @(PIN content) < eitherCase (getRecord cdx)
                 _&(LEFT [404 b#{digest only, no content}])
| RIGHT content

= (nameServer st query)
| query | getNames st

= (updateWhitelist new st)
^ (tabFoldlWithKey _ new (getWhitelist st), setWhitelist new st)
& (rem url _) | tabDel url rem

= extraExampleWhitelist
| tabIns {http://new.com/} [TRUE] exampleWhitelist

=?= | updateWhitelist extraExampleWhitelist
    | setWhitelist exampleWhitelist emptyWarcState
  ([{http://new.com/}=[TRUE]], setWhitelist extraExampleWhitelist emptyWarcState)


= (warcWriter hermes pid (cmd,msg) return)
# switch cmd
* PORT | modifyState (setHttpPort SOME-msg) return
* WHITELIST
  @ (rid,pBody) | msg
  : newWhite < maybeCase (parseWhite pBody)
             | send (pid,rid) FALSE return
  : _ < send (pid,rid) (printWhitelist newWhite)
  : diff < stateState (updateWhitelist newWhite)
  : (cdxs,names) < getsState st&(getCdxs st, biMapKeys getNames-st)
  @ filteredRefs | map cdxToRef | filter (isPublic diff) | tabValsRow cdxs
  | if (null filteredRefs) | return ()
  : _ < rowTraverse name&(send (hermes,0) (name,filteredRefs)) names
  | return ()
* WARC
  @ (rid,body) | msg
  : mOur < getsState getOur
  : our < maybeCase mOur
        | trk , warcWriter %noOur
        | send (pid,rid) []
        | return
  : evalResult < work buildCDX [our body]
  : newCDXs < eitherCase evalResult
            & error
            | trk , warcWriter [=error]
            | send (pid,rid) []
            | return
  | trk , warcWriter [writing=(map getCanonicalUrl newCDXs)]
  @ newRefs | map cdxToRef newCDXs
  : _ < send (pid,rid) newRefs
  : _ < modifyState | addCDXs newCDXs
  : (names,whitelist) < getsState st&(biMapKeys getNames-st, getWhitelist-st)
  @ filteredRefs | filter (isPublic whitelist) newRefs
  | if (null filteredRefs) | return ()
  : _ < rowTraverse name&(send (hermes,0) (name,filteredRefs)) names
  | return ()


= (cdxWriter _ (cmd,msg))
# switch cmd 
* CDX  | modifyState | addCDXs msg
* PORT | modifyState (setHermesPort SOME-msg)


= (inbox cdx)
| launch_ | DB_WRITE (%CDX, cdx)

= (repeatEvery t return)
: now < launch TIME_WHEN
: _   < launch | TIME_WAIT | add now 1
^ _ return
? (go return)
: _   < launch_ | DB_WRITE ()
: now < launch TIME_WHEN
: _   < launch | TIME_WAIT | add now t
| go return

= (writeHttp response return)
@ HTTP_RES(..) response
| ifNot statusCode==200 | trk writeHttp,[not200=statusCode =response] | return ()
| launch_ | DB_WRITE resBody
| return


= (parseNames our bar)
@ (entries,_) | parseJson bar
| maybeGuard (len entries /= 0)
: xs
  < ^ rowTraverse _ entries
    & (entry return)
    : name  < bindMaybe | tabLookup %name entry
    : ipBar < bindMaybe | tabLookup %ip   entry
    : ip    < bindMaybe | ipToNat ipBar
    : mPort < bindMaybe | tabLookup %hermes_port entry
    : port  < bindMaybe | mPort
    | return (name, (ip,port))
^ SOME | foldl _ emptyBiMap xs
& (names (name,addr))
| if name==our | names
| biMapInsert name addr names


= (nameWriter _ resBody return)
: mOur < getsState getOur
: our < maybeCase mOur | trk %noOur | return ()
: res < work parseNames [our resBody]
: mNames < eitherCase res error&(trk [=error] return-())
: names < maybeCase mNames | trk [noNewNamesIn=resBody] | return ()
| trk , nameWriter [=names]
| modifyState (setNames names) return


= (syncNames httpClient return)
: _ < send (httpClient,0) (GET, NAME_SERVER_GET, emptyTab, b#{})
: (mHermesPort, mHttpPort, mOur)
  < getsState st&(getHermesPort st, getHttpPort st, getOur st)
: hermesPort < maybeCase mHermesPort | return ()
: httpPort   < maybeCase mHttpPort   | return ()
: our        < maybeCase mOur        | trk %noOur | return ()
: _ < send (httpClient,0)
    ++ POST
    ++ NAME_SERVER_POST
    ++ tabFromPairs 
       ++ , b#{accept}       b#{application/json}
       ++ , b#{Content-Type} b#{application/json}
    ++ ^ printJson (JMAP _)
       ## =name        our
       ## =hermes_port printNat-hermesPort 
       ## =signature   b#{}
       ## =warc_port   printNat-httpPort
| return ()


= (identityDriver return)
: our < launch | CLI_OPT b#our
: key < launch | CLI_OPT b#key
| launch_ | DB_WRITE (our,key)
| return


= (identityWriter _ (mOur,mKey) return)
| trk , identityWriter [setKey=mKey]
: _ < modifyState (setSecretKey mKey)
: our < getsState getOur
| if (isSome our)  | trk %already_owned | return ()
| if (isNone mOur) | trk %no_our        | return ()
| trk , identityWriter [born=mOur]
| modifyState (setOur mOur)
| return


> Cog ()
= (warcCog return)
: _ < install identityDriver die identityWriter
: httpClient < install (makeHttpClient writeHttp) die nameWriter
: hermes < install (makeHermes inbox) nameServer cdxWriter
: http   < install (httpServer requestHandler) readHandler (warcWriter hermes)
: _      < install repeatEvery-120 die (_ _)&(syncNames httpClient)
| return ()


= main | runCog emptyWarcState warcCog
