#### driver_http_client <- driver_http

; Things that need to happen:
; - Test passing JSON body in a POST request - probably need to do a bunch after that
; - Properly test the server loop / processMessage flow with multiple
;   connections. re-open / new connections, etc.

:| lib_http

= NAME_SERVER_DOMAIN
| b#{localhost:8000}

= NAME_SERVER_GET
| barCat [b#{http://} NAME_SERVER_DOMAIN b#{/users}]

= NAME_SERVER_POST
| barCat [b#{http://} NAME_SERVER_DOMAIN b#{/announce}]


= NAME_SERVER_ADDR
| (16777343, 8000)

= (ipToNat bar)
: nats
  < ^ traverseList _ | barSplit {.} bar
    & (byte return)
    : n < bindMaybe | parseNat byte
    | maybeGuard | lth n 256
    | return n
| maybeGuard (listLen nats == 4)
^ SOME | listSum | listZipWith mul nats _
| listMap pow-256 ~[0 1 2 3]


=?= SOME-16777343  | ipToNat b#{127.0.0.1}
=?= SOME-612615823 | ipToNat b#{143.198.131.36}
=?= NONE           | ipToNat b#{143.1.1}
=?= NONE           | ipToNat b#{143.1.1.1.1}
=?= NONE           | ipToNat b#{foo}

= (splitURL url)
: (protocol,address) < bindMaybe | barSplitOnSubstring b#{//} url
@ (domain,path) | barSplitOne {/} address
| SOME (domain, barWeld b#{/} path)

=?= SOME-(NAME_SERVER_DOMAIN, b#{/users})
  | splitURL NAME_SERVER_GET

;; Method Path Headers Body
# typedef AppRequest (Method, Bar, Tab Bar Bar, Bar)

; TODO:
> AppRequest > Bit
= (validRequest res@(method, path, headers, body))
| rowAnd
++ (len-res == 4)
++ (method==GET || method==POST)
++ isBar path
++ isTab headers
++ isBar body


> AppRequest > HTTPRequest
= (appRequestToHttp fromCog@(method, url, headers, body) host path)
| maybeGuard | validRequest fromCog
| SOME
@ version      | b#{HTTP/1.1}
@ contentLength | natBar | showNat | barLen body ; should be zero if not present
@ headers | tabIns b#{Content-Length} contentLength
          | tabIns b#{User-Agent} b#{Pallas/0.1}
          | tabIns b#Host host
          | headers
| HTTP_REQ
* method
* path
* version
* headers
* PIN body


= (dnsLookup domain)
| if (domain == NAME_SERVER_DOMAIN) | NAME_SERVER_ADDR
| die dnsLookup

= (processResponse ip port return)
^ _ newResParser
? (go parser)
: data < launch | TCP_TAKE ip port
| if (barIsEmpty data)
  ; trk [connectionClosed=io]
  | return | LEFT b#{connection closed before response received}
@ newParser | feedResData parser data
: res < maybeCase (getResponse newParser) | go newParser
: _   < launch_ | TCP_SHUT ip port
| return res


= (makeHttpClient responseHandler return)
: port < launch TCP_MINE
| trk , makeHttpClient [=port]
^ _ return
? (go return)
: fromCog@(method,url,headers,body) < listen
: (host,path) < maybeCase | splitURL url
              | trk , makeHttpClient [invalid=url]
              | go return
: req < maybeCase | appRequestToHttp fromCog host path
      | trk , makeHttpClient [invalid=fromCog]
      | go return
@ (ip,port) | dnsLookup host
: open < launch | TCP_OPEN ip port
| ifNot open
  | trk , makeHttpClient {couldn't connect} [=ip =port]
  | go return
^ _ | httpReqToBar req
? (sendAndListen requestBar)
| trk , makeHttpClient [=requestBar =ip =port]
: mBytes < launch | TCP_GIVE ip port requestBar
: bytes < maybeCase mBytes | launch_ (TCP_SHUT ip port) | go return
| if (barLen requestBar /= bytes) | sendAndListen | barDrop bytes requestBar
: res < processResponse ip port
: res < eitherCase res error&(trk [=error] | go return)
: _   < responseHandler res
| go return


